{
  "$id": "invariant-corpus-v2",
  "title": "Invariant reference corpus",
  "required": ["schema", "claim_scope", "invariants", "free_coordinates"],
  "properties": {
    "schema": {"const": "invariant-corpus-v2"},
    "claim_scope": {"const": "computational-integrity-only"},
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {"required": ["id", "kind"]}
    },
    "free_coordinates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "required": ["id", "chart"],
        "properties": {
          "chart": {
            "type": "string",
            "pattern": "^chart\\.",
            "description": "The coordinate system the declaration in 'needs' fixes this quantity in. Globally unique across the corpus index, so two members declaring the same needle id stay distinguishable."
          }
        }
      }
    }
  }
}
